# NORDR Performance — environment variable NAMES only.
# Copy to Vercel Project Settings → Environment Variables.
# Never put real secrets in this file or commit them to GitHub.

# Supabase project URL
# Find in: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase anon/public key (safe for browser admin session + RLS)
# Find in: Supabase Dashboard → Project Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=

# Supabase service role key (server-side only — never expose to the browser)
# Find in: Supabase Dashboard → Project Settings → API → Project API keys → service_role
# WARNING: This key bypasses Row Level Security. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated origins allowed to call the API (defaults include nordrperformance.com and localhost)
# ALLOWED_ORIGINS=https://nordrperformance.com,http://localhost:3000
